# Copy to .env for local development. Replace the placeholder password.
POSTGRES_PASSWORD=replace-with-a-long-local-development-password
DATABASE_URL=postgresql+psycopg://cryptogo@localhost:5432/cryptogo
APP_ENV=development
TELEGRAM_BOT_TOKEN=
DEV_AUTH_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_ENABLE_DEV_AUTH=true
REACT_APP_MAP_STYLE_URL=

# Production must set APP_ENV=production, a real bot token, Secure cookies,
# trusted HTTPS origins, and a production-grade database password.
