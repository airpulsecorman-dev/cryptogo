# Copy to .env for local development. Replace the placeholder password.
POSTGRES_PASSWORD=replace-with-a-long-local-development-password
APP_ENV=development
TELEGRAM_BOT_TOKEN=
DEV_AUTH_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production must set APP_ENV=production, a real bot token, Secure cookies,
# trusted HTTPS origins, and a production-grade database password.
